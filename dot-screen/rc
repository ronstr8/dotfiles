# ==========================================================
# Modern GNU Screen 5+ Configuration (Truecolor + Clean)
# ==========================================================

startup_message off
msgwait 1
vbell off
nethack on
autodetach on
altscreen on
defutf8 on
defbce on
shelltitle "$ |bash"
autosavestate on

# ------------------------------
# Color & Terminal Support
# ------------------------------
truecolor on
term screen-256color

termcapinfo xterm* 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm:ks=:ke=:ti@:te@'
termcapinfo screen* 'Co#256:AB=\E[48;5;%dm:AF=\E[38;5;%dm'

defdynamictitle off
attrcolor b ".I"          # Bold → bright/italic where needed

# ------------------------------
# Scrollback & Copy
# ------------------------------
defscrollback 20000
defwrap on
ignorecase on

# ------------------------------
# Status Line
# ------------------------------
hardstatus on
hardstatus alwayslastline
#hardstatus string "%{=bW} %-w%{=bR}%n*%t%{-}%+w %= %{=bG}%H %{=bY}%` %{=bW}%l "
#hardstatus string "%{= .;15} %-w%{= .;9}%n*%t%{-}%+w %=%{= .;10}%H %{= .;11}%m/%d %c %{= .;14}%a %l "
#hardstatus string "%{= .;15}%-w%{= .;9}%n*%t%{-}%+w %= %{= .;10}%H %{= .;11}%m/%d %c %{= .;14}%a %l "
# Transparent background + colored foreground + italics attempt
hardstatus string "%{= 15}%-w%{= 9}%n*%t%{-}%+w %= %{= 10}%H %{= 11}%` %{= 14}%l "

# ------------------------------
# Key Bindings
# ------------------------------
# Ctrl+Shift+Left  → Previous window
# Ctrl+Shift+Right → Next window

bindkey "^[[1;3D" prev
bindkey "^[[1;3C" next

bindkey -m "^[[A" stuff k
bindkey -m "^[[B" stuff j

# ------------------------------
# Misc
# ------------------------------
backtick 0 30 30 date +'%F %T'  # Example: use %` in hardstatus for custom info

