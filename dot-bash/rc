## ln -s ~/.bash/rc ~/.bashrc
##      User specific aliases and functions.  Invoked for all shells.

[ -f '/etc/bashrc' ] && . /etc/bashrc ;

BASHDIR="$HOME/.bash" ;

[ -f "$BASHDIR/init"   ] && source "$BASHDIR/init" ;
[ -f "$BASHDIR/stdlib" ] && source "$BASHDIR/stdlib" ;

if (( BASHRC_MINIMAL > 0 )) ; then
    requireLib prompt ;
fi

RCFILES=(
    environment
    aliases
    completion
    path
    shopts
	secret
) ;

for rcFile in ${RCFILES[@]} ; do
    [ -f "$BASHDIR/$rcFile" ] && . "$BASHDIR/$rcFile" ;
done

#ssh-agent-sync

## This `local' call source should always be last, allowing override of
## everything set above.
if   [ -f "$BASHRC_LOCALRC" ] ; then
    source "$BASHRC_LOCALRC" ;
elif [ -f "$BASHDIR/local" ] ; then
    source "$BASHDIR/local" ;
fi

# vim: ft=sh

PATH="/home/ronstr8/perl5/bin${PATH:+:${PATH}}"; export PATH;
PERL5LIB="/home/ronstr8/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"; export PERL5LIB;
PERL_LOCAL_LIB_ROOT="/home/ronstr8/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"; export PERL_LOCAL_LIB_ROOT;
PERL_MB_OPT="--install_base \"/home/ronstr8/perl5\""; export PERL_MB_OPT;
PERL_MM_OPT="INSTALL_BASE=/home/ronstr8/perl5"; export PERL_MM_OPT;

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

. "$HOME/.local/bin/env"

# >>> juliaup initialize >>>

# !! Contents within this block are managed by juliaup !!

case ":$PATH:" in
    *:/home/ronstr8/.juliaup/bin:*)
        ;;

    *)
        export PATH=/home/ronstr8/.juliaup/bin${PATH:+:${PATH}}
        ;;
esac

# <<< juliaup initialize <<<


# Added by Antigravity CLI installer
export PATH="/home/ronstr8/.local/bin:$PATH"
