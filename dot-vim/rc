if has("multi_byte")
    if &termencoding == ""
        let &termencoding = &encoding
    endif
    set encoding=utf-8
    setglobal fileencoding=utf-8
    "setglobal bomb
    "set fileencodings=ucs-bom,utf-8,latin1

	digraph ?! 8253
	digraph !? 8253
    digraph .3 2026
elseif &encoding == "iso-8859-15"
 	digraph oe 189
endif

if has("conceal")
    set conceallevel=0 
    autocmd FileType json setlocal conceallevel=0 
endif 

