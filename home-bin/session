## session [options]
##
##      Write hardcopy of current screen window and its history to a session
##      directory.  Default check of $WINDOW to determine window number.
##
##      If second arg is given, the part before the slash is considered the
##      window number and the part after the title.  The window will be renumbered and
##      retitled.  If another window existed with that number, it will be moved to
##      the $WINDOW envvar, or renamed with a date extension if no $WINDOW.
##
##  --status         Show data relevant to the current session.
##  --dump-hardcopy
##
##  --eval       Echo some export commands useful for future invocations.
##  --screeenrc  Write a new screenrc in the root session directory.
##  --commit     Commit session directory changes to VCS (git).
##  --vivify     Create the session directory if it does not exist.
##
##  --checkpoint Intended to be called from a PROMPT_COMMAND; save session state
##               if it has been more than a half hour since last save.
##
##  --session=s  The name of the current session, default $SESSION_NAME.
##
##  --title=s       Set the title of the current window
##  --renumber-to=n Change the current window number, swapping state files if it already exists.
##
##  --verbose  Include more output at verbosity level 1.
##  --debug    ... add 10 to the verbosity value.
##  --trace    ... and 20 to the verbosity value.
##
##  --terse    Omit any unnecessary embellishment from output.
##
##  --help     Show this message.
##
## -- 
## Ronald E. Straight <straight@adiant.com>

SCRIPT_NAME="$( basename "$0" )"

ERR=1
OK=0

DO_STATUS=''
EVAL=''
WRITE_SCREENRC=''
COMMIT_SESSION=''
VIVIFY=''
RETITLE_TO=''
RENUMBER_TO=''
OPT_SESSION=''
RESTORE_FROM=''
CHECKPOINT_WAIT_SECONDS=''
LOAD_SAVED_HARDCOPY='yes'
DO_HARDCOPY_DUMP=''

MV_CMD='mv'

declare -a SESSION_VARS=(
    SESSION_NAME
    SESSION_HOME
    WINDOW
    WINDOW_NUMBER
    WINDOW_HOME
    HISTFILE
)

FRIDGE_DIR="$HOME/.screen/sessions"
CHDIR_BASENAME='chdir'
TITLE_BASENAME='title'
HISTORY_BASENAME='history'
ENV_BASENAME='env'
HARDCOPY_BASENAME='hardcopy'
WINDOWRC_BASENAME='windowrc'
WINDOWLOGIN_BASENAME='window_login'

function __getOptions() {
    local allOptions=(
        debug trace terse eval screenrc commit vivify
        session: title: renumber-to: restore-window:
        checkpoint status dump-hardcopy
    )

    local longOpts
    local IFS=','
    longOpts="${allOptions[*]}"
    unset IFS

    local getoptOutput
    getoptOutput=$( getopt -o hvn --long "help,verbose,dry-run,${longOpts}" --name "$0" -- "$@" ) \
        && eval set -- "$getoptOutput" || return 1

    while true; do case "$1" in
            --status)        DO_STATUS='yes';               shift ;;
            --dump-hardcopy) DO_HARDCOPY_DUMP='yes';        shift ;;
            --eval)          EVAL='yes';                    shift ;;
            --screenrc)      WRITE_SCREENRC='yes';          shift ;;
            --commit)        COMMIT_SESSION='yes';          shift ;;
            --vivify)        VIVIFY='yes';                  shift ;;
            --checkpoint)    CHECKPOINT_WAIT_SECONDS=1800;  shift ;;
            --session)       OPT_SESSION="$2";              shift 2 ;;
            --title)         RETITLE_TO="$2";               shift 2 ;;
            --renumber*)     RENUMBER_TO="$2";              shift 2 ;;
            --restore*)      RESTORE_FROM="$2";             shift 2 ;;

            -h|--help)
                awk '/^## -- $/ { exit } !/^#!/ { gsub("^#+ ?", ""); print }' "$0" >&2
                return 1 ;;
            -v|--verbose) VERBOSITY+=1;  VERBOSISM+=('verbose');  shift ;;
            -n|--dry-run) DRY_RUN=1; VERBOSITY+=1; VERBOSISM+=('dry-run'); shift ;;
            --debug)      VERBOSITY+=10; VERBOSISM+=('debug');    shift ;;
            --trace)      TRACE='trace'; VERBOSITY+=20; VERBOSISM+=('trace'); shift ;;
            --terse)      TERSE='terse';                          shift ;;
            --)           shift; break ;;
    esac; done

    [[ ! "$OPT_SESSION" && $# -eq 1 ]] && OPT_SESSION="$1"
    return 0
}

function __whinge() {
    echo "# [$( date +%Y-%m-%dT%H:%M:%S )] $*" 1>&2
}

function __croak() {
    __whinge "$@"
    return $ERR
}

function __buildWindowDir() {
    printf '%s/window-%02d' "$1" "$2"
}

function __parseWindowDir() {
    local dir="${1##*/window-}"
    echo "$(( 10#$dir ))"
}

function __echoScreenRc() {
    local sessionName="$1"
    local sessionDir="$2"
    local currentWinNumber="$3"

    [[ "$sessionName" ]] || { __croak "echoScreenRc needs a sessionName."; return $ERR; }
    [[ "$sessionDir" && -d "$sessionDir" ]] \
        || { __croak "__echoScreenRc: missing or non-directory sessionDir."; return $ERR; }

    ## TODO: Don't overwrite some of these options (defwrap, hardcopy_append)
    ## and instead respect preferences from ~/.screenrc.

    cat <<EOT
    ## Generated by $0 at $( date -Is ).

    source '$HOME/.screenrc'

    sessionname '$sessionName'

    setenv SESSION_NAME '$sessionName'
    setenv SESSION_HOME '$sessionDir'

    defwrap on
    hardcopy_append off

EOT

    local winDir
    for winDir in "$sessionDir"/window-*; do
        [[ -d "$winDir" ]] || continue

        local winNumber
        winNumber="$( __parseWindowDir "$winDir" )"
        local winCwd
        winCwd="$( cat "$winDir/$CHDIR_BASENAME" 2>/dev/null )"
        local winTitle
        winTitle="$( cat "$winDir/$TITLE_BASENAME" 2>/dev/null )"
        local winHardcopyFile="$winDir/$HARDCOPY_BASENAME"
        local winHistoryFile="$winDir/$HISTORY_BASENAME"
        local winRcFile="$winDir/$WINDOWRC_BASENAME"
        local winLoginFile="$winDir/$WINDOWLOGIN_BASENAME"

        local screenCmd='screen'
        [[ "$winTitle" ]] && screenCmd="${screenCmd} -t '${winTitle}'"
        screenCmd="${screenCmd} ${winNumber}"

        local winHeader="Window #${winNumber}"
        [[ "$winTitle" ]] && winHeader="${winHeader} AKA \"${winTitle}\""

        cat <<EOT

        ## ${winHeader}

$( [[ "$winCwd" ]] && echo "        chdir '${winCwd}'" )
        setenv WINDOW_HOME "${winDir}"
        setenv WINDOW_NUMBER "${winNumber}"
        setenv HISTFILE "${winHistoryFile}"

        hardcopydir "${winDir}"

EOT
        [[ -e "$winRcFile"  ]] && echo "        source '${winRcFile}'"

        echo "        ${screenCmd}"

        [[ -e "$winHardcopyFile" && "$LOAD_SAVED_HARDCOPY" ]] \
            && echo "        exec cat '${winHardcopyFile}'"

        cat <<'EOT'

        clear
        stuff "\n"

EOT
        [[ -e "$winLoginFile" ]] && echo "        source '${winLoginFile}'"
    done

    echo '    unsetenv HISTFILE'
    echo "    select ${currentWinNumber}"
    echo
    echo "    ## vim: ft=screen"
    echo
}

function __evalCommented() {
    __whinge "\$ $*"
    "$@" 2>&1 | sed 's/^/# /g' >&2
}

function __stuffRenumberedWindow() {
    local destWindowNumber="$1"
    local destWindowDir="$1"

    local destWindowStuff="export WINDOW='$destWindowNumber' WINDOW_NUMBER='$destWindowNumber' WINDOW_HOME='$destWindowDir' HISTFILE='$destWindowDir/$HISTORY_BASENAME'"
    screen -X at $destWindowNumber stuff "${destWindowStuff}\015"
}

function __changeWindowNumber() {
    local sessionDir="$1"
    local currWindowNumber="$2"
    local destWindowNumber="$3"

    [[ "$sessionDir"       ]] || { __croak "__changeWindowNumber needs a sessionDir.";       return $ERR; }
    [[ "$currWindowNumber" ]] || { __croak "__changeWindowNumber needs a currWindowNumber."; return $ERR; }
    [[ "$destWindowNumber" ]] || { __croak "__changeWindowNumber needs a destWindowNumber."; return $ERR; }

    local currWindowDir="$( __buildWindowDir "$sessionDir" "$currWindowNumber" )"
    local destWindowDir="$( __buildWindowDir "$sessionDir" "$destWindowNumber" )"
    local tempWindowDir="$sessionDir/moving-${destWindowNumber}-$( date +'%Y%m%d%H%M%S' )"

    [[ -d "$destWindowDir" ]] && __evalCommented "$MV_CMD" "$destWindowDir" "$tempWindowDir"
    [[ -d "$currWindowDir" ]] && __evalCommented "$MV_CMD" "$currWindowDir" "$destWindowDir"
    [[ -d "$tempWindowDir" ]] && __evalCommented "$MV_CMD" "$tempWindowDir" "$currWindowDir"

    screen -X number "$destWindowNumber" || return $ERR

    __stuffRenumberedWindow $destWindowNumber "$destWindowDir"
    __stuffRenumberedWindow $currWindowNumber "$currWindowDir"

    __retitleWindow $destWindowNumber $( cat "$destWindowDir/$TITLE_BASENAME" )
    __retitleWindow $currWindowNumber $( cat "$currWindowDir/$TITLE_BASENAME" )


}

function __commitSessionToVcs() {
    local sessionDir="$1"
    [[ "$sessionDir" ]] || { __croak "__commitSessionToVcs needs a sessionDir."; return $ERR; }

    local -a gitOpts=( --git-dir="${sessionDir}/.git" --work-tree="${sessionDir}" )
    __whinge "Committing changes in $sessionDir ..."
    __evalCommented git "${gitOpts[@]}" init --quiet
    __evalCommented git "${gitOpts[@]}" add "$sessionDir"
    __evalCommented git "${gitOpts[@]}" commit --message='Checkpoint of session data.' "$sessionDir"
}

function __echoBashEnv() {
    local winDir="${1:-$WINDOW_HOME}"
    local winHistoryFile="$winDir/$HISTORY_BASENAME"

    export | grep -E '(HISTFILE|SESSION_NAME|WINDOW|WINDOW_NUMBER|OLDPWD)' | sed 's/$/ ;/g'

    echo

    dirs -l -p | sed 's/^/pushd -n /g; s/$/ ;/g'

    cat <<EOT

    export HISTFILE='${winHistoryFile}' ;
    [[ -e "$HISTFILE" ]] && history -r $HISTFILE ;

    unset BASH_ENV ;

EOT
}

function __echoExports() {
    local declaration='declare -x'
    local varName
    for varName in "${SESSION_VARS[@]}"; do
        declaration+=" ${varName}='${!varName}'"
    done
    echo "$declaration"
}

function __maybeVivifySessionDir() {
    if [[ -d "$SESSION_HOME" ]]; then
        return
    elif [[ "$VIVIFY" ]]; then
        mkdir -p "$SESSION_HOME"
    else
        __croak "Cannot continue if $SESSION_HOME does not exist and no --vivify."
        return $ERR
    fi
}

function __isWindowAlive() {
    local windowNumber="$1"
    local touchFile
    touchFile="$( mktemp )"
    rm -f "$touchFile"

    screen -p "$windowNumber" -X exec touch "$touchFile"

    if [[ -e "$touchFile" ]]; then
        rm -f "$touchFile"
        return 0
    fi
    return 1
}

function __validateSessionState() {
    if [[ "$OPT_SESSION" ]]; then
        SESSION_NAME="$OPT_SESSION"
    elif [[ "$SESSION_NAME" ]]; then
        true
    elif [[ "$STY" =~ ^[0-9]+\..+ ]]; then
        SESSION_NAME="${STY#*.}"
    else
        __croak 'Cannot continue without $SESSION_NAME, $STY indicating a name, or --session=s.'
        return $ERR
    fi

    SESSION_HOME="$FRIDGE_DIR/$SESSION_NAME"
}

function __validateWindowState() {
    if [[ ! "$WINDOW_NUMBER" ]]; then
        if [[ "$WINDOW" ]]; then
            __whinge "Defaulting WINDOW_NUMBER=$WINDOW."
            export WINDOW_NUMBER="$WINDOW"
        else
            __croak 'Cannot continue without $WINDOW_NUMBER or $WINDOW.'
            return $ERR
        fi
    elif [[ ! "$WINDOW" ]]; then
        __whinge "WINDOW unset; setting to \$WINDOW_NUMBER ($WINDOW_NUMBER)."
        export WINDOW="$WINDOW_NUMBER"
    elif [[ "$WINDOW_NUMBER" != "$WINDOW" ]]; then
        __whinge "WINDOW=$WINDOW != WINDOW_NUMBER=$WINDOW_NUMBER; setting WINDOW_NUMBER=$WINDOW."
        export WINDOW_NUMBER="$WINDOW"
    fi

    export WINDOW_HOME="$( __buildWindowDir "$SESSION_HOME" "$WINDOW_NUMBER" )"
}

function __maybeRenumberWindow() {
    [[ "$RENUMBER_TO" ]] || return 0
    if [[ "$RENUMBER_TO" -eq "$WINDOW_NUMBER" ]]; then
        __whinge "\$WINDOW_NUMBER $WINDOW_NUMBER is same as --renumber-to. No change."
        return 0
    fi
    __changeWindowNumber "$SESSION_HOME" "$WINDOW_NUMBER" "$RENUMBER_TO"
}

function __maybeRetitleWindow() {
    [[ "$RETITLE_TO" ]] || return 0
    __retitleWindow "$WINDOW_NUMBER" "$RETITLE_TO"
}

function __retitleWindow() {
    local window="$1"
    local title="$2"

    # Set the screen title
    screen -X at "$window" title "$title"

    # Write it to the session window title
    local winTitleFile=$( __buildWindowDir "$SESSION_HOME" "$window" )/$TITLE_BASENAME
    echo "$title" > "$winTitleFile"

    return 0
}

function __dumpWindowHardcopy() {
    screen -X hardcopydir "$WINDOW_HOME"

    local hcFile="$WINDOW_HARDCOPY_FILE"

    if [[ -e "$hcFile" ]]; then
        local hcLastModYmd todayYmd
        hcLastModYmd="$( date --ref="$hcFile" +%Y%m%d )"
        todayYmd="$( date +%Y%m%d )"
        [[ "$hcLastModYmd" != "$todayYmd" ]] && mv "$hcFile" "${hcFile}.${todayYmd}"
    fi

    screen -X hardcopy -h "$hcFile"
}

function __saveWindowState() {
    local histFile="${WINDOW_HISTORY_FILE:-$HISTFILE}"
    local historyCommand="history -a \"${histFile}\""

    if [[ -e "$histFile" ]]; then
        if [[ "$EVAL" ]]; then
            echo "$historyCommand ;"
        else
            eval "$historyCommand"
        fi
    else
        touch "$histFile"
    fi

    pwd > "$WINDOW_CHDIR_FILE"
    __echoBashEnv > "$WINDOW_ENV_FILE"
    __dumpWindowHardcopy

    [[ "$WRITE_SCREENRC" ]] \
        && __echoScreenRc "$SESSION_NAME" "$SESSION_HOME" "$WINDOW_NUMBER" > "$SESSION_HOME/screenrc"
    [[ "$COMMIT_SESSION" ]] && __commitSessionToVcs "$SESSION_HOME"
    [[ "$EVAL" ]] && __echoExports
    return 0
}

function __loadWindowState() {
    local sessionName="$1"
    local sessionDir="$2"
    local winNumber="${3:-$WINDOW}"

    local winDir
    winDir="$( __buildWindowDir "$sessionDir" "$winNumber" )"
    local winHistoryFile="$winDir/$HISTORY_BASENAME"

    export SESSION_NAME="$sessionName"
    export WINDOW="$winNumber"
    export WINDOW_NUMBER="$winNumber"
    export WINDOW_HOME="$winDir"
    export HISTFILE="$winHistoryFile"

    declare -x WINDOW_HISTORY_FILE="$WINDOW_HOME/$HISTORY_BASENAME"
    declare -x WINDOW_TITLE_FILE="$WINDOW_HOME/$TITLE_BASENAME"
    declare -x WINDOW_CHDIR_FILE="$WINDOW_HOME/$CHDIR_BASENAME"
    declare -x WINDOW_HARDCOPY_FILE="$WINDOW_HOME/$HARDCOPY_BASENAME"
    declare -x WINDOW_ENV_FILE="$WINDOW_HOME/$ENV_BASENAME"

    [[ "$EVAL" ]] && __echoExports
    [[ -e "$winHistoryFile" ]] && history -r "$winHistoryFile"
}

# Returns 0 if enough time has elapsed for a checkpoint, 1 otherwise.
function __isReadyForCheckpoint() {
    local staleSeconds="${1:-1800}"
    local refFile="$WINDOW_HOME/$HISTORY_BASENAME"

    if [[ ! -e "$refFile" ]]; then
        touch "$refFile"
        return 0
    fi

    local nowEpoch refEpoch
    nowEpoch="$( date +%s )"
    refEpoch="$( date +%s --reference="$refFile" )"

    (( ( refEpoch + staleSeconds ) < nowEpoch ))
}

function __echoStatus() {
    local winDir subDir histFile histTime cwdFile cwd titleFile title statusLine
    local wtf='‽‽‽'

    __whinge "$SESSION_HOME"
    __whinge

    for winDir in "$SESSION_HOME"/window-*; do
        [[ -d "$winDir" ]] || continue
        subDir="$( basename "$winDir" )"

        histFile="$winDir/$HISTORY_BASENAME"
        histTime="$( date --ref="$histFile" +'%m/%d/%Y@%H:%M:%S' 2>/dev/null )"

        cwdFile="$winDir/$CHDIR_BASENAME"
        cwd="$( awk -v home="$HOME" '{ gsub(home, "~"); print }' "$cwdFile" )"

        titleFile="$winDir/$TITLE_BASENAME"
        title="$( cat "$titleFile" 2>/dev/null )"

        statusLine="$( printf '%s AKA %-18s %s   %s' \
            "$subDir" "${title:-$wtf}" "${histTime:-$wtf}" "${cwd:-$wtf}" )"
        __whinge "$statusLine"
    done

    __whinge
    __whinge "$( __echoExports )"
}

## 0-black 1-red 2-green 3-yellow 4-blue 5-magenta 6-cyan 7-white

function __dumpHardcopyFiles() {
    local fileName skippedLine
    local -a skippedLines=()
    local -i skippedLineThreshold=24

    for fileName in "$@"; do
        while IFS= read -r REPLY; do
            if [[ "$REPLY" =~ ^[[:space:]]*$ ]]; then
                skippedLines+=("$REPLY")
                continue
            fi

            if (( ${#skippedLines[@]} <= skippedLineThreshold )); then
                for skippedLine in "${skippedLines[@]}"; do
                    echo "$skippedLine"
                done
            else
                printf '\n\n## skippedLines+=%d %s%s%s\n\n' \
                    "${#skippedLines[@]}" \
                    "$( tput setaf 3 )" "$( yes '#' | head -n 10 | xargs )" "$( tput sgr0 )"
            fi

            skippedLines=()
            echo "$REPLY"
        done < "$fileName"
    done
}

function __main() {
    __validateSessionState  || return $ERR
    __maybeVivifySessionDir || return $ERR

    if [[ ! "$STY" && "$SESSION_HOME" ]]; then
        local screenRc="$SESSION_HOME/screenrc"
        [[ ! -e "$screenRc" ]] && __echoScreenRc "$SESSION_NAME" "$SESSION_HOME" "0" > "$screenRc"
        exec screen -c "$screenRc"
        return  # Never reached.
    fi

    screen -X setenv SESSION_NAME "$SESSION_NAME"

    __validateWindowState || return $ERR

    mkdir -p "$WINDOW_HOME"

    declare -x WINDOW_HISTORY_FILE="$WINDOW_HOME/$HISTORY_BASENAME"
    declare -x WINDOW_TITLE_FILE="$WINDOW_HOME/$TITLE_BASENAME"
    declare -x WINDOW_CHDIR_FILE="$WINDOW_HOME/$CHDIR_BASENAME"
    declare -x WINDOW_HARDCOPY_FILE="$WINDOW_HOME/$HARDCOPY_BASENAME"
    declare -x WINDOW_ENV_FILE="$WINDOW_HOME/$ENV_BASENAME"

    __maybeRetitleWindow || return $ERR

    if [[ "$CHECKPOINT_WAIT_SECONDS" ]]; then
        if __isReadyForCheckpoint "$CHECKPOINT_WAIT_SECONDS"; then
            EVAL='yes'
            WRITE_SCREENRC='yes'
        fi
    fi

    __maybeRenumberWindow || return $ERR

    if [[ "$RESTORE_FROM" ]]; then
        __loadWindowState "$SESSION_NAME" "$SESSION_HOME" "$RESTORE_FROM" || return $ERR
    fi

    export HISTFILE="$WINDOW_HISTORY_FILE"
    export SESSION_HOME SESSION_NAME WINDOW_HOME WINDOW_NUMBER

    [[ "$DO_HARDCOPY_DUMP" ]] \
        && __dumpHardcopyFiles "${WINDOW_HOME}/${HARDCOPY_BASENAME}."* "$WINDOW_HARDCOPY_FILE"

    __saveWindowState || return $ERR

    [[ "$DO_STATUS" ]] && __echoStatus
    return 0
}

## Run in a subshell so any `exit' from called functions will not cause an
## interactive shell that sources this file to exit.

( __getOptions "$@" && __main )

