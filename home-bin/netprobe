#!/usr/bin/env bash

DEFAULT_TIMEOUT=3 ;

DEFAULT_SSH_TIMEOUT=$(( DEFAULT_TIMEOUT * 2 )) ;

DEFAULT_PING_DEADLINE=${DEFAULT_TIMEOUT} ;

DEFAULT_LOOKUP_TIMEOUT=${DEFAULT_TIMEOUT} ;

TRACERT_PROBE_WAIT=${DEFAULT_TIMEOUT} ; 
## *MAX_TTL Too low? Some sites are more than a hop, skip and a jump away.
## However, for the purposes of testing local-ish connectivity as through
## the fiber of AWS Direct Connect, this is more than enough. Also, keep
## in mind that the total "timeout" is this times *PROBE_WAIT seconds.
TRACERT_MAX_TTL=10 ;
TRACERT_METHODS=( tcp ) ; # icmp udp raw ) ;
TRACERT_ASYNC_PROBES=1 ;
TRACERT_PROBES_PER_HOP=1 ;

## @see https://www.arin.net/resources/whoisrws/whois_api.html#whoisrws
## Can also use /rest/cidr/x.x.x.x/bm.
WHOIS_URI_FORMAT='http://whois.arin.net/rest/ip/%s.txt' ;
#       curl -sS 'http://whois.arin.net/rest/ip/69.55.75.59.txt'

TRACERT_OPT_E=$( traceroute -e --help &>/dev/null && echo ' -e ' ) ;
## Full traceroute invocation, w/ method and host appended.
TRACERT_SUDO='sudo' ;

IPV4_OCTET_REGEX='(2([0-4][0-9]|5[0-5])|1[0-9][0-9]|[0-9]{1,2})' ;
#IPV4_REGEX="((${IPV4_OCTET_REGEX}\.){3,3}${IPV4_OCTET_REGEX})" ;
IPV4_REGEX_FORMAT="(${IPV4_OCTET_REGEX}(%s${IPV4_OCTET_REGEX}){3,3})" ;
IPV4_RESERVED_REGEX="(^(10|192\.168|172\.(1[6-9]|2[0-9]|3[01]))\.)" ;

unset -f __renderIpRegexFormat ; function __renderIpRegexFormat() {
    ## A regex expr matching what would be dots in an IPv4 octet-quad.
    local dotSubst="${1:-.}" ;

    printf '%s' "${IPV4_REGEX_FORMAT//%s/${dotSubst}}" ;
}

unset -f __isValidIp ; function __isValidIp() {
    local ipv4="$1" ;
    local ipRe ;
    ipRe=$( __renderIpRegexFormat '[.-]' ) ;

    echo "${ipv4}" | grep -E -q "${ipRe}" ;
} ;

unset -f __isReservedIp ; function __isReservedIp() {
    local ipv4="$1" ;

    echo "${ipv4}" | grep -E -q "${IPV4_RESERVED_REGEX}" ;
} ;

unset -f __extractHostFromAddr ; function __extractHostFromAddr() {
    local host="$1" ;

    echo -n "${host// /}" | tr -d ' ' | sed "s/<[^>]\+>//;" || true ;
} ;

unset -f __getHostFromAddr ; function __getHostFromAddr() {
    __extractHostFromAddr "$@" ;
}

unset -f __extractIpFromAddr ; function __extractIpFromAddr() {
    local host="$1" ;
    local ipRe ;
    ipRe=$( __renderIpRegexFormat '[.-]' ) ;

#   local cutted=$( echo -n "$host" | egrep -o "$IPV4_REGEX" ) ;
#   local dotted=$( echo -n "$cutted" | tr -c '0-9' '.' ) ;
#   echo "Host: «$host» ; Cut: «$cutted» ; Dotted: «$dotted»" ; # 1>&2 ;
#   echo "$dotted" ;

#   echo -n "${host// /}" | egrep -o "$ipRe" | tr -d "\n" | tr -c '0-9' '.' ;
    echo -n "${host// /}" | grep -E -m1 -o "${ipRe}" | head -n 1 | sed -e 's/^\([^[:space:]]\+\).*$/\1/; s/[^0-9]/./g;' || true # tr -d "\n" | tr -c '0-9' '.' ;
} ;

unset -f __lookupHost ; function __lookupHost() {
    local host="$1" ;

    local waitSeconds=${DEFAULT_LOOKUP_TIMEOUT} ;

    # -C        Display SOA for all listed authoritative records.
    # -v/-d     Verbose/debug.
    # -T        Use TCP instead of UDP requests to nameservers.
    # -4        Force IPv4 transport.
    # -t        Query type: A, AAAA, MX, CNAME, NS, SOA, SIG, KEY, AXFR, PTR, IXFR, etc.
    # -a        Query type of ANY.
    # -W        Seconds to wait for a reply.

#   host -v -d -C -a -W $waitSeconds "$host" ;
    host -W "${waitSeconds}" "${host}" 2>/dev/null | awk '/has address/ { print $4 }' || true ;
} ;

unset -f __getIpFromAddr ; function __getIpFromAddr() {
    local addr="$1" ;
    local ipv4 ;
    ipv4=$( __extractIpFromAddr "${addr}" ) ;

    if [[ -z "${ipv4}" ]] ; then
        ipv4=$( __lookupHost "${addr}" ) ;
    fi

    echo "${ipv4}" ;
}

unset -f __setFgBg ; function __setFgBg() {
    local fg="$1" ;
    local bg="$2" ;

    (
                     tput op        ; # Reset
        [[ -n "${fg}" ]] && tput setaf "${fg}" ; # Set foreground color.
        [[ -n "${bg}" ]] && tput setab "${bg}" ; # Set background color.

    ) 2>/dev/null ; # Ignore all errors.
} ;

unset -f __resetFgBg ; function __resetFgBg() {
    __setFgBg '' '' ;
} ;

unset -f __echoColoredThenReset ; function __echoColoredThenReset() {
    local fgc="${1}" ;
    local bgc="${2}" ;
    local msg="${3}" ;

    __setFgBg "${fgc}" "${bgc}" ;

    echo -n "${msg}" ;

    __resetFgBg ;

    echo ;
} ;

unset -f __echoHostHeader ; function __echoHostHeader() {
    local host=$1 ;
    local line ;
    line=$( printf " %-72s " "${host}" ) ;
    local rule ;
    rule=$( printf "%*s" ${#line} ' ' ) ;

    echo ;

    __echoColoredThenReset 4 7 "${rule}" ;
    __echoColoredThenReset 4 7 "${line}" ;
    __echoColoredThenReset 4 7 "${rule}" ;

    echo ;
}

unset -f __echoComment ; function __echoComment() {
    local msg=$1 ;

    echo ;

    __setFgBg 8 ;

    echo -n "##### [$( date -Is )] ${msg}" || true ;

    __resetFgBg ;

    echo ;
    echo ;
} ;

unset -f __whinge ; function __whinge() {
    __echoComment "$*" 1>&2 ;
}

unset -f __croak ; function __croak() {
    local msg="${*:-Skip/failing.}" ;

    __echoColoredThenReset 1 0 "${msg}" ;

    return 1 ;
}

unset -f __sshHost ; function __sshHost() {
    local host="$1" ;
    local user="${2:-$( id -un )}" ;
    local timeout=${3:-${DEFAULT_SSH_TIMEOUT}} ;

    __echoComment "ssh ${user}@${host}" ;

    ssh -o "ConnectTimeout=${timeout}" "${user}@${host}" 'echo "[$( date -Is )] SSH $( hostname ) OK"' ;
} ;

unset -f __whoisHost ; function __whoisHost() {
    local ipv4=$1 ; # "${1//./-}" ;
    local uri ;
    uri=$( printf '%s' "${WHOIS_URI_FORMAT//%s/${ipv4}}" ) ;

    __echoComment "WHOIS <${uri}>" ;

    curl -sS -X GET "${uri}" ;
} ;

unset -f __pingHost ; function __pingHost() {
    local host="$1" ;
    local deadline=${2:-${DEFAULT_PING_DEADLINE}} ;

    __echoComment "ping ${host}" ;

    ping -w "${deadline}" "${host}" ;
} ;


unset -f __traceHostWithMethod ; function __traceHostWithMethod() {
    local host="$1" ;
    local method="${2:-tcp}" ;
    local sudoCmd="${TRACERT_SUDO}" ;

#   local opt_e=' -e ' ; if ! traceroute -e localhost &>/dev/null ; then opt_e='' ; fi

    local -a traceCmd=( traceroute -4 -q "${TRACERT_PROBES_PER_HOP}" -d -A -w "${TRACERT_PROBE_WAIT}" -m "${TRACERT_MAX_TTL}" -N "${TRACERT_ASYNC_PROBES}" -M "${method}" "${host}" ) ;
    if [[ -n "${TRACERT_OPT_E}" ]] ; then
        traceCmd=( "${traceCmd[@]}" -e ) ;
    fi

    __echoComment "${traceCmd[*]}" ;

    if [[ -n "${sudoCmd}" ]] ; then
        "${sudoCmd}" "${traceCmd[@]}" ;
    else
        "${traceCmd[@]}" ;
    fi
} ;

unset -f __traceHost ; function __traceHost() {
    local host="$1" ;
    local methods=( "${TRACERT_METHODS[@]}" ) ;


    # -4    Force IPv4 transport.
    # -d    Enable socket-level debugging.
    # -g    Explicit gateway for outgoing packet.  "gateway1,gateway2,gatewayN"
    # -i    Explicit interface to use.  Default selected from routing table(s).
    # -m    Max TTL (or seconds w/default incr TTL by 1/hop) probed.  Default 30.
    # -N    Number of simultaneous probes.  Default 16.
    # -n    Avoid name lookups.
    # -w    Time to wait for a probe response.  Default 5 seconds.
    # -r    Bypass routing table(s) and send directly host on attached network.
    # -s    Alternative source address. Defaults to primary of outgoing interface.
    # -e    Show RFC4884 ICMP extension data.
    # -A    Print AS (autonomous system) from routing registries.
    # -M    Method to use:
    #           icmp    - Should work if ping does, but then we wouldn't be using this script.
    #           tcp     - Intended to bypass firewalls.
    #           udp     - Also intended to bypass firewalls.
    #           udplite - UDP w/constant destination port.
    #           raw     - Raw packets consisting only of IP header.

    for method in "${methods[@]}" ; do
        __traceHostWithMethod "${host}" "${method}" ;

#       sudo traceroute -4 -d -e -A -w $probeWait -m $maxTtl -N $probes -M $method "$host" ;
    done

    # After the trip time, some additional annotation can be printed:
    # !H, !N, or !P (host, network or protocol unreachable),
    # !S (source route failed),
    # !F (fragmentation  needed),
    # !X (communication administratively prohibited),
    # !V (host precedence violation),
    # !C (precedence cutoff in effect), or
    # !<num> (ICMP unreachable code <num>).

    # Troubleshooting:
    #   * Try 'ping -R' if no hops report.
    #   * For greater stability, use '-z 0.5' to pause between hops.
    #   * Try '-N 1', esp. if final target host drops probes.
} ;

unset -f __tcpConnectHost ; function __tcpConnectHost() {
    local host="$1" ;
    local port="$2" ;
    local timeout=${3:-${DEFAULT_PING_DEADLINE}} ;

    __echoComment "tcp connect ${host}:${port}" ;

    if timeout "${timeout}" bash -c "exec 3<>/dev/tcp/${host}/${port}" &>/dev/null ; then
        __echoComment "TCP connect ${host}:${port} OK" ;
    else
        __croak "TCP connect ${host}:${port} failed." ;
    fi
}

unset -f __httpProbeHost ; function __httpProbeHost() {
    local url="${1}" ;
    local timeout=${2:-${DEFAULT_PING_DEADLINE}} ;

    __echoComment "HTTP GET <${url}>" ;

    local code ;
    code=$( curl -sS -o /dev/null -w '%{http_code}' --max-time "${timeout}" "${url}" 2>/dev/null ) ;

    if [[ "${code}" = 000 ]] ; then
        __croak "HTTP GET ${url} failed (no response)." ;
    fi

    echo "${code}" ;
}

unset -f __dnsProbeHost ; function __dnsProbeHost() {
    local host="${1}" ;

    __lookupHost "${host}" ;
}

unset -f __certProbeHost ; function __certProbeHost() {
    local host="${1}" ;
    local port="${2:-443}" ;

    __echoComment "TLS cert check ${host}:${port}" ;

    local notAfter ;
    notAfter=$( echo | openssl s_client -connect "${host}:${port}" -servername "${host}" 2>/dev/null | openssl x509 -noout -enddate ) || true ;

    echo "${notAfter}" ;
}

unset -f __mtrProbeHost ; function __mtrProbeHost() {
    local host="${1}" ;

    __echoComment "mtr ${host}" ;

    if [[ -n "${TRACERT_SUDO}" ]] ; then
        "${TRACERT_SUDO}" mtr -C -c 1 "${host}" ;
    else
        mtr -C -c 1 "${host}" ;
    fi
}

unset -f __nmapProbeHost ; function __nmapProbeHost() {
    local host="${1}" ;

    __echoComment "nmap ${host}" ;

    nmap -T4 "${host}" ;
}

unset -f __testHost ; function __testHost() {
    local addr="${1}" ;
    local doSsh="${2:-0}" ;
    local sshUser="${3:-$( id -un )}" ;

    __echoHostHeader "${addr}" ;

    local host ;
    host=$( __getHostFromAddr "${addr}" ) ;

    if [[ -z "${host}" ]] ; then
        __croak "Failed to deduce hostname from string «${addr}»." ;
        return ;
    fi

#   echo "addr=«$addr» host=«$host» ipv4=«$ipv4»" 1>&2 ;

    local ipv4 ;
    ipv4=$( __getIpFromAddr "${addr}" ) ;

    if [[ -z "${ipv4}" ]] ; then
        __croak "Failed to deduce IPv4 address from string «${addr}»." ;
        return ;
    fi

#   echo "addr=«$addr» host=«$host» ipv4=«$ipv4»" 1>&2 ;

    if ! __isValidIp "${ipv4}" ; then
        __croak "String «${ipv4}» does not look like an IPv4 address." ;
        return ;
    fi

    if __isReservedIp "${ipv4}" ; then
        __whinge "IPv4 «${ipv4}» is in the private range reserved by RFC1918." ;
    else
        __whoisHost "${ipv4}" ;
    fi

    if [[ "${doSsh}" -eq 1 ]] ; then
        __sshHost "${ipv4}" "${sshUser}" ;
    fi

    __pingHost "${ipv4}" ;
    __traceHost "${ipv4}" ;
} ; 

# echo "IPV4_OCTET_REGEX:«$IPV4_OCTET_REGEX»" ;
# echo "IPV4_REGEX=«$IPV4_REGEX»" ;
# echo "IPV4_RESERVED_REGEX=«$IPV4_RESERVED_REGEX»" ;

unset -f __usage ; function __usage() {
    cat <<'EOF'
Usage: netprobe [options] <host> <ip> [<host> <ip> ...]

Probe a host for whois, ping, traceroute and (optionally) ssh reachability.

Options:
  --ssh          Probe ssh reachability. Off by default.
  --user <user> SSH user to use when probing ssh. (default: current user)
  --port <port> TCP connect probe to <addr>:<port> for each address.
  --http <url>   HTTP GET probe for <url>.
  --dns <host>   DNS lookup for <host>.
  --cert <host>  TLS cert check for <host> (default port 443).
  --mtr <host>   mtr probe for <host>.
  -h, --help    Show this help.

Address format: «host <ip>» (e.g. 'ip-10-17-0-172.ec2.internal <10.17.0.172>')
EOF
}

unset -f __main ; function __main() {
    declare -a addresses ;
    declare addr ;
    declare doSsh=0 ;
    declare sshUser ;
    sshUser=$( id -un ) ;
    declare port= ;
    declare httpUrl= ;
    declare dnsHost= ;
    declare certHost= ;
    declare mtrHost= ;
    declare doTcpPort=0 ;
    declare doHttp=0 ;
    declare doDns=0 ;
    declare doCert=0 ;
    declare doMtr=0 ;
    declare doNmap=1 ;

    while [[ $# -gt 0 ]] ; do
        case "$1" in
            --ssh)              doSsh=1 ; shift ;;
            --user)            shift ; sshUser="$1" ; shift ;;
            --user=*)          sshUser="${1#--user=}" ; shift ;;
            -h|--help)         __usage ; return 0 ;;
            --)                shift ; break ;;
            --port)            shift ; port="$1" ; shift ; doTcpPort=1 ;;
            --http)            shift ; httpUrl="$1" ; shift ; doHttp=1 ;;
            --dns)             shift ; dnsHost="$1" ; shift ; doDns=1 ;;
            --cert)            shift ; certHost="$1" ; shift ; doCert=1 ;;
            --mtr)             shift ; mtrHost="$1" ; shift ; doMtr=1 ;;
            -*)                __croak "Unknown option: «$1»." ; return 1 ;;
            *)                 addresses+=( "$1" ) ; shift ;;
        esac
    done

    if [[ ${#addresses[@]} -eq 0 ]] ; then
        if [[ ${doHttp} -ne 1 && ${doDns} -ne 1 && ${doCert} -ne 1 && ${doMtr} -ne 1 && ${doNmap} -ne 1 && ${doTcpPort} -ne 1 ]] ; then
            __croak "No address given. Pass one or more «host <ip>» arguments." ;
            return ;
        fi
    fi

    if [[ ${#addresses[@]} -gt 0 ]] ; then
        for addr in "${addresses[@]}" ; do
            __testHost "${addr}" "${doSsh}" "${sshUser}" ;
        done
    fi

    if [[ ${doTcpPort} -eq 1 && ${#addresses[@]} -gt 0 ]] ; then
        for addr in "${addresses[@]}" ; do
            local tcpAddrIpv4 ;
            tcpAddrIpv4=$( __getIpFromAddr "${addr}" ) ;
            __tcpConnectHost "${tcpAddrIpv4}" "${port}" ;
        done
    fi

    if [[ ${doHttp} -eq 1 ]] ; then
        __httpProbeHost "${httpUrl}" ;
    fi

    if [[ ${doDns} -eq 1 ]] ; then
        __dnsProbeHost "${dnsHost}" ;
    fi

    if [[ ${doCert} -eq 1 ]] ; then
        __certProbeHost "${certHost}" ;
    fi

    if [[ ${doMtr} -eq 1 ]] ; then
        __mtrProbeHost "${mtrHost}" ;
    fi

    if [[ ${doNmap} -eq 1 ]] ; then
        __nmapProbeHost "${addr}" ;
    fi
} ; __main "$@" ;

